# These are FC environment variable examples. Never commit real credentials.
# No dotenv loader is used. Configure FC variables in its console.
BINANCE_API_KEY=replace-with-read-only-api-key
BINANCE_API_SECRET=replace-with-api-secret
OSS_REGION=oss-cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=replace-with-your-private-bucket

# Optional explicit OSS credentials; when set, both are required and take precedence
# over the FC function role. Leave both unset to use the role's temporary credentials.
# These are FC environment variables, separate from GitHub deployment Secrets.
# ACCESS_KEY_ID=replace-with-oss-ram-access-key-id
# ACCESS_KEY_SECRET=replace-with-oss-ram-access-key-secret

# Optional; the following are defaults.
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_SYMBOLS=BTCUSDT
OSS_PREFIX=fc/binance-sync/owner
OSS_CNAME=false
SYNC_INITIAL_DAYS=30
SYNC_OVERLAP_SECONDS=86400
REQUEST_TIMEOUT_MS=15000
SYNC_MAX_SECONDS=240
BINANCE_RECV_WINDOW=5000
BINANCE_REQUEST_GAP_MS=250

# HTTP JWT verification only; console/InvokeFunction events do not need these.
# Generate the matching private/public pair with: node scripts/generate-sync-keys.mjs
# JWT verification is configured only on the FC native ingress.
